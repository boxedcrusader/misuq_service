{
  "name": "misuq-service",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "test": "jest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@google/genai": "^2.16.0",
    "@nestjs/common": "^10",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^10",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mapped-types": "^2",
    "@nestjs/platform-express": "^10",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "^6",
    "class-transformer": "^0.5",
    "class-validator": "^0.14",
    "helmet": "^8.3.0",
    "reflect-metadata": "^0.2",
    "rxjs": "^7"
  },
  "devDependencies": {
    "@nestjs/testing": "^10",
    "@types/jest": "^29",
    "@types/node": "^20",
    "jest": "^29",
    "prisma": "^6",
    "ts-jest": "^29",
    "ts-node": "^10",
    "typescript": "^5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/test"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "maxWorkers": 1
  }
}
