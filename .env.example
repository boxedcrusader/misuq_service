DATABASE_URL="postgresql://user:password@localhost:5432/misuq?schema=public"
GEMINI_API_KEY=

# JWT auth (src/modules/auth/auth.config.ts) -- the server refuses to boot
# without these. Two DIFFERENT values, each >= 32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Optional, in seconds. Defaults: 900 (15 min) / 2592000 (30 days).
# JWT_ACCESS_TTL_SECONDS=
# JWT_REFRESH_TTL_SECONDS=
