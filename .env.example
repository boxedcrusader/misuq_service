DATABASE_URL="postgresql://user:password@localhost:5432/misuq?schema=public"
GEMINI_API_KEY=

# JWT auth (src/modules/auth/auth.config.ts) -- the server refuses to boot
# without these. Two DIFFERENT values, each >= 32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Optional, in seconds. Defaults: 900 (15 min) / 2592000 (30 days).
# JWT_ACCESS_TTL_SECONDS=
# JWT_REFRESH_TTL_SECONDS=

# Browser origins allowed by CORS, comma-separated (src/main.ts). Defaults to
# the local web dev server; production = the deployed web URL.
# CORS_ORIGIN=https://misuq.pages.dev
# Reverse-proxy hops to trust for the client IP the rate limiter keys on.
# Leave unset locally; 1 on Render. Never "true" (lets clients spoof IPs).
# TRUST_PROXY=1
# Per-account caps on Gemini-backed actions per rolling 24h (src/common/usage-limits.ts).
# DAILY_DRAFT_LIMIT=30
# DAILY_REPORT_LIMIT=30

# Which model provider backs each LLM step (src/common/llm-selection.ts):
# "gemini" (default) or "claude". Only the selected provider's key is required;
# a missing key stops the server at boot.
# DRAFTING_LLM=claude     # Claude Sonnet 5.5
# EXTRACTION_LLM=claude   # Claude Haiku 5.5
# ANTHROPIC_API_KEY=
